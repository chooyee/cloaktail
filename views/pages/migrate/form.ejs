<%- include('../../partials/header') %>
<%
  const err = (name) => (field === name ? error : null);
  const generalError = error && !field ? error : null;
  const fullName = [migration.firstName, migration.lastName].filter(Boolean).join(' ');
  const steps = [
    ['Choose a new password', 'You’ll use it with your username from now on.'],
    ...(requireOtp ? [['Set up an authenticator app', 'The next time you sign in, you’ll scan a QR code with an app such as Google Authenticator, Microsoft Authenticator or FreeOTP.']] : []),
    [`Back to ${appName}`, 'You’ll continue where you left off.'],
  ];
%>
<div class="mx-auto grid max-w-4xl items-start gap-10 py-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-16 lg:py-10">
  <section class="lg:pt-6">
    <p class="text-sm font-medium text-muted-foreground"><%= appName %></p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-balance">Set up your new sign-in</h1>
    <p class="mt-3 max-w-md text-muted-foreground text-pretty">
      <%= appName %> is moving to a new sign-in system. Your account details are already filled in; just choose a new password.
    </p>

    <h2 class="mt-10 text-sm font-semibold">What happens next</h2>
    <ol class="mt-4 grid gap-4 text-sm">
      <% steps.forEach(([title, text], i) => { %>
        <li class="flex gap-3">
          <span class="flex size-6 shrink-0 items-center justify-center rounded-full border text-xs font-medium"><%= i + 1 %></span>
          <div><p class="font-medium"><%= title %></p><p class="text-muted-foreground"><%= text %></p></div>
        </li>
      <% }) %>
    </ol>
  </section>

  <div class="grid gap-3">
    <form id="migrate-form" class="card" method="post" action="/migrate">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <section class="grid gap-4">
        <% if (generalError) { %>
          <div class="alert" data-variant="destructive" role="alert"><section><%= generalError %></section></div>
        <% } %>

        <dl class="grid gap-x-4 gap-y-2 rounded-md border bg-muted/40 px-3 py-2.5 text-sm sm:grid-cols-[6rem_1fr]">
          <dt class="text-muted-foreground">Username</dt><dd class="break-all font-medium"><%= migration.username %></dd>
          <% if (fullName) { %><dt class="text-muted-foreground">Name</dt><dd class="break-words"><%= fullName %></dd><% } %>
          <% if (migration.email) { %><dt class="text-muted-foreground">Email</dt><dd class="break-all"><%= migration.email %></dd><% } %>
        </dl>
        <p class="-mt-2 text-xs text-muted-foreground">Something wrong? Cancel and contact <%= appName %> support before continuing.</p>

        <%# Lets password managers save the new password under the right username. %>
        <input type="text" name="username" value="<%= migration.username %>" autocomplete="username" hidden readonly>

        <%- include('../../fragments/text-field', { name: 'password', label: 'New password', type: 'password', autocomplete: 'new-password', reveal: true,
              hint: error ? 'For your security, passwords aren’t kept after an error. Please enter it again.' : 'At least 8 characters. The password policy may require more.',
              attrs: 'required minlength="8" maxlength="256"', invalid: err('password') }) %>

        <%- include('../../fragments/text-field', { name: 'confirmPassword', label: 'Confirm new password', type: 'password', autocomplete: 'new-password', reveal: true,
              attrs: 'required minlength="8" maxlength="256"', invalid: err('confirmPassword') }) %>
      </section>
      <footer class="grid gap-3">
        <button type="submit" class="btn w-full">Set password and continue</button>
      </footer>
    </form>

    <form method="post" action="/migrate/cancel" class="text-center">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn" data-variant="ghost" data-size="sm">Cancel and go back to <%= appName %></button>
    </form>
  </div>
</div>

<script>
  // Show/Hide toggles for password fields.
  document.querySelectorAll('[data-reveal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const input = document.getElementById(btn.dataset.reveal);
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.textContent = show ? 'Hide' : 'Show';
      btn.setAttribute('aria-pressed', String(show));
    });
  });
  // Prevent double submission while Keycloak creates the account.
  document.getElementById('migrate-form').addEventListener('submit', (e) => {
    const btn = e.target.querySelector('button[type=submit]');
    btn.disabled = true;
    btn.textContent = 'Setting up your account…';
  });
</script>
<%- include('../../partials/footer') %>
