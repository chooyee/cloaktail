<%- include('../../partials/header') %>
<header class="page-header">
  <div class="min-w-0">
    <h1 class="page-title">Users</h1>
    <p class="page-description">Accounts live in Keycloak; roles are assigned in this app.</p>
  </div>
  <% if (can('users.create')) { %>
    <div class="page-actions"><a href="/users/new" class="btn"><%- icon('plus') %>New user</a></div>
  <% } %>
</header>

<div class="mt-6 max-w-sm">
  <label for="user-search" class="sr-only">Search users</label>
  <input id="user-search" class="input" type="search" name="q" value="<%= search %>"
         placeholder="Search username, name or email…"
         hx-get="/users" hx-trigger="input changed delay:300ms, search"
         hx-target="#users-table" hx-swap="outerHTML" hx-push-url="true">
</div>

<div class="mt-4">
  <%- include('../../fragments/users-table') %>
</div>
<%- include('../../partials/footer') %>
