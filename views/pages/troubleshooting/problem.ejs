<%- include('../../partials/header', { structuredData: content.problemStructuredData(problem, baseUrl) }) %>
<% const sections = [['Why it happens', problem.causes], ['How to confirm', problem.check], ['How to fix it', problem.fix]]; %>
<article class="mx-auto max-w-3xl py-6">
  <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
    <ol class="flex flex-wrap gap-2">
      <li><a href="/" class="hover:text-foreground hover:underline">CloakTail</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/troubleshooting" class="hover:text-foreground hover:underline">Troubleshooting</a></li>
    </ol>
  </nav>
  <h1 class="mt-4 text-3xl font-semibold tracking-tight text-balance"><%= problem.q %></h1>
  <p class="mt-3 text-lg text-muted-foreground text-pretty"><%= problem.a %></p>
  <p class="mt-2 text-xs text-muted-foreground">Keycloak SAML troubleshooting · Last updated <time datetime="<%= content.updated %>"><%= content.updatedLabel %></time></p>

  <div class="mt-10 grid gap-8 text-sm leading-relaxed">
    <section>
      <h2 class="text-base font-semibold">What you see</h2>
      <p class="mt-2 text-muted-foreground"><%- content.inline(problem.symptom) %></p>
    </section>
    <% for (const [heading, items] of sections) { %>
      <section>
        <h2 class="text-base font-semibold"><%= heading %></h2>
        <ul class="mt-2 grid list-disc gap-2 pl-5 text-muted-foreground">
          <% for (const item of items) { %><li><%- content.inline(item) %></li><% } %>
        </ul>
      </section>
    <% } %>
  </div>

  <aside class="mt-12 rounded-xl border bg-muted/40 p-6">
    <h2 class="font-semibold">See exactly what Keycloak sends</h2>
    <p class="mt-2 text-sm text-muted-foreground">A CloakTail test login shows the status, audience, signatures, attributes and raw XML of a real sign-in, so you can tell a Keycloak problem from an app problem.</p>
    <a href="<%= user ? '/apps' : (registrationEnabled ? '/register' : '/login') %>" class="btn mt-4" data-size="sm"><%= user ? 'Open your applications' : (registrationEnabled ? 'Create developer account' : 'Sign in') %></a>
  </aside>

  <section class="mt-12">
    <h2 class="text-base font-semibold">Other problems</h2>
    <ul class="mt-3 grid gap-2 text-sm">
      <% for (const other of content.problems.filter((p) => p !== problem)) { %>
        <li><a href="/troubleshooting/<%= other.slug %>" class="underline-offset-4 hover:underline"><%= other.q %></a></li>
      <% } %>
    </ul>
  </section>
</article>
<%- include('../../partials/footer') %>
