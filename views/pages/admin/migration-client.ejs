<%- include('../../partials/header') %>
<%
  const isNew = !client;
  const fieldError = (key) => errors[key];
  const STATUS_VARIANTS = { created: 'default', already_migrated: 'default', conflict: 'destructive', error: 'destructive', started: 'secondary', cancelled: 'secondary', expired: 'secondary' };
  // Textarea with hint and inline error; returns HTML, so every value is escaped here.
  const textarea = (name, label, { rows = 3, hint = '', placeholder = '' } = {}) => {
    const err = fieldError(name);
    return `<div class="field gap-1.5" ${err ? 'data-invalid="true"' : ''}>
      <label for="${name}">${label}</label>
      <textarea id="${name}" name="${name}" rows="${rows}" class="font-mono text-xs" spellcheck="false" placeholder="${placeholder}"
        ${err ? 'aria-invalid="true"' : ''}>${escape(values[name] || '')}</textarea>
      ${err ? `<p class="text-xs text-destructive">${escape(err)}</p>` : ''}
      ${hint ? `<p class="text-xs">${hint}</p>` : ''}
    </div>`;
  };
  function escape(s) { return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]); }
%>
<a href="<%= basePath %>" class="text-sm text-muted-foreground hover:underline">← User migration: <%= profile.name %></a>
<div class="mt-2 flex flex-wrap items-center gap-3">
  <h1 class="text-2xl font-semibold"><%= isNew ? 'New migration client' : client.name %></h1>
  <% if (!isNew) { %><span class="badge" data-variant="<%= client.enabled ? 'default' : 'secondary' %>"><%= client.enabled ? 'Enabled' : 'Disabled' %></span><% } %>
</div>
<p class="mt-1 max-w-3xl text-muted-foreground">
  Users are created in the sandbox realm <code><%= profile.settings.sandboxRealm %></code> by its service account
  <code><%= profile.settings.sandboxAdminClientId %></code>, with the profile exactly as the application sends it.
</p>

<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_22rem]">
  <div class="grid gap-6 self-start">
    <form id="client-form" class="card" method="post" action="<%= action %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <section class="grid gap-8">
        <%- include('../../fragments/form-status', { error, message }) %>
        <% if (!isNew && client.secretsUnreadable) { %>
          <div class="alert" data-variant="destructive" role="alert">
            <h2>The client secret can’t be read</h2>
            <section>It was encrypted with a different <code>SETTINGS_KEY</code> or <code>SESSION_SECRET</code>. Generate a new one.</section>
          </div>
        <% } %>

        <div class="grid gap-4">
          <h2 class="font-semibold">Application</h2>
          <%- include('../../fragments/text-field', { name: 'name', label: 'Name', value: values.name, autocomplete: 'off',
                attrs: 'required maxlength="80"', hint: 'Shown to users: “Set up your new sign-in for …”.', invalid: fieldError('name') }) %>
          <%- include('../../fragments/text-field', { name: 'clientId', label: 'Client ID', value: values.clientId, autocomplete: 'off',
                attrs: 'required maxlength="255" spellcheck="false"', hint: 'The application puts it in the iss claim of its requests.', invalid: fieldError('clientId') }) %>
          <%- textarea('returnUrls', 'Return URLs', { placeholder: 'https://app.example.com/migrated',
                hint: 'One per line. Users are sent back only to one of these, exactly as written (the request’s return_url must match).' }) %>
          <div class="field" data-orientation="horizontal">
            <input type="checkbox" id="enabled" name="enabled" <%= values.enabled ? 'checked' : '' %>>
            <label for="enabled" class="text-sm font-normal">Enabled: accept requests from this application</label>
          </div>
        </div>

        <div class="grid gap-4">
          <div>
            <h2 class="font-semibold">Request signature</h2>
            <p class="text-sm text-muted-foreground">How CloakTail checks that a request really comes from the application. Results sent back are always signed with the client secret (HS256).</p>
          </div>
          <div class="field gap-1.5" <%- fieldError('requestKey') ? 'data-invalid="true"' : '' %>>
            <label for="requestKey">Requests are signed with</label>
            <select id="requestKey" name="requestKey" class="h-9">
              <% for (const [key, label] of Object.entries(REQUEST_KEYS)) { %>
                <option value="<%= key %>" <%= values.requestKey === key ? 'selected' : '' %>><%= label %></option>
              <% } %>
            </select>
            <% if (fieldError('requestKey')) { %><p class="text-xs text-destructive"><%= fieldError('requestKey') %></p><% } %>
          </div>
          <div data-key-option="publicKey" <%= values.requestKey === 'publicKey' ? '' : 'hidden' %>>
            <%- textarea('publicKey', 'Public key (PEM)', { rows: 6, placeholder: '-----BEGIN PUBLIC KEY-----',
                  hint: 'RSA (2048 bits or more), EC or Ed25519. Accepted algorithms: RS*, PS*, ES*, EdDSA.' }) %>
          </div>
          <div data-key-option="jwks" <%= values.requestKey === 'jwks' ? '' : 'hidden' %>>
            <%- include('../../fragments/text-field', { name: 'jwksUrl', label: 'JWKS URL', value: values.jwksUrl, autocomplete: 'off',
                  attrs: 'spellcheck="false" placeholder="https://app.example.com/.well-known/jwks.json"',
                  hint: 'Fetched and cached for 10 minutes; a new key id is fetched at once, so key rotation just works.', invalid: fieldError('jwksUrl') }) %>
          </div>
        </div>

        <div class="grid gap-4">
          <div>
            <h2 class="font-semibold">New accounts</h2>
            <p class="text-sm text-muted-foreground">No email is sent, and emails are not marked verified.</p>
          </div>
          <div class="field" data-orientation="horizontal">
            <input type="checkbox" id="requireOtp" name="requireOtp" <%= values.requireOtp ? 'checked' : '' %>>
            <section>
              <label for="requireOtp" class="text-sm font-normal">Require OTP: users set up an authenticator app at their first Keycloak sign-in</label>
              <p class="text-xs text-muted-foreground">Adds the <code>CONFIGURE_TOTP</code> required action. It must be enabled in the realm (Authentication → Required actions).</p>
            </section>
          </div>
        </div>
      </section>
      <footer class="flex justify-end gap-2">
        <a href="<%= isNew ? basePath : action %>" class="btn" data-variant="outline"><%= isNew ? 'Cancel' : 'Discard changes' %></a>
        <button type="submit" class="btn"><%= isNew ? 'Create migration client' : 'Save' %></button>
      </footer>
    </form>

    <% if (!isNew) { %>
      <div class="card">
        <header>
          <h2>Integrate the application</h2>
          <p>After a user signs in with their old password and isn’t migrated yet, send them to CloakTail with a signed request.</p>
        </header>
        <section class="grid gap-4 text-sm">
          <dl class="grid gap-x-6 gap-y-2 sm:grid-cols-[9rem_1fr]">
            <dt class="text-muted-foreground">Start URL</dt>
            <dd class="grid gap-1">
              <% if (startUrls.length) { for (const u of startUrls) { %><code class="break-all"><%= u %></code><% } } else { %>
                <span class="text-destructive">None: the profile serves no domain.</span><% } %>
            </dd>
            <dt class="text-muted-foreground">How</dt>
            <dd><code>GET …/migrate/start?request=&lt;JWT&gt;</code>, or a form <code>POST</code> with a <code>request</code> field (keeps it out of logs).</dd>
            <dt class="text-muted-foreground">Request claims</dt>
            <dd>
              <code>iss</code> (client ID), <code>aud</code> (the start URL’s domain + <code>/migrate</code>), <code>iat</code>, <code>exp</code> (at most 10 minutes later),
              <code>jti</code> (unique, used once), <code>sub</code> (your user id), <code>preferred_username</code>, <code>return_url</code>;
              optional <code>email</code>, <code>given_name</code>, <code>family_name</code>, <code>state</code>.
            </dd>
            <dt class="text-muted-foreground">Result</dt>
            <dd>
              Back at the return URL with <code>?result=&lt;JWT&gt;</code>, HS256 with the client secret: <code>status</code>
              (<code>created</code>, <code>already_migrated</code>, <code>conflict</code>, <code>cancelled</code>, <code>expired</code>, <code>error</code>),
              <code>sub</code>, <code>preferred_username</code>, <code>keycloak_id</code>, <code>state</code>, <code>aud</code> (client ID), <code>exp</code> (5 minutes).
            </dd>
            <dt class="text-muted-foreground">In Keycloak</dt>
            <dd>Attributes <code><%= MIGRATION_ATTRIBUTES.legacyId %></code> (your <code>sub</code>), <code><%= MIGRATION_ATTRIBUTES.migratedFrom %></code> (client ID) and <code><%= MIGRATION_ATTRIBUTES.migratedAt %></code>.</dd>
          </dl>
          <div class="overflow-hidden rounded-md border">
            <div class="flex items-center justify-between border-b bg-muted/40 px-3 py-1.5">
              <span class="text-xs font-medium">Node.js</span>
              <button type="button" class="btn" data-variant="ghost" data-size="xs" data-copy="<%= sample %>">Copy</button>
            </div>
            <pre class="max-h-[32rem] overflow-auto p-4 text-xs"><code class="hljs language-javascript"><%- highlight(sample, 'javascript') %></code></pre>
          </div>
        </section>
      </div>

      <div class="card">
        <header>
          <h2>Recent requests</h2>
          <p>
            <% const statuses = Object.entries(counts); %>
            <%= statuses.length ? statuses.map(([k, n]) => `${n} ${k.replace('_', ' ')}`).join(' · ') : 'None yet.' %>
          </p>
        </header>
        <% if (events.length) { %>
          <section class="overflow-x-auto">
            <table class="table text-sm">
              <thead><tr><th>When (UTC)</th><th>Username</th><th>Legacy id</th><th>Status</th><th>Detail</th></tr></thead>
              <tbody>
                <% for (const e of events) { %>
                  <tr>
                    <td class="whitespace-nowrap"><%= e.updated_at %></td>
                    <td class="break-all"><%= e.username %></td>
                    <td class="break-all font-mono text-xs"><%= e.legacy_id %></td>
                    <td><span class="badge" data-variant="<%= STATUS_VARIANTS[e.status] || 'secondary' %>"><%= e.status.replace('_', ' ') %></span></td>
                    <td class="max-w-xs break-words text-xs text-muted-foreground"><%= e.detail || '' %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </section>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="grid gap-6 self-start">
    <% if (isNew) { %>
      <div class="card">
        <header><h2>After you create it</h2></header>
        <section class="grid gap-2 text-sm text-muted-foreground">
          <p>CloakTail generates the client secret and shows it once. The application uses it to check results (and to sign requests, with the client secret method).</p>
          <p>The sandbox realm must keep CloakTail’s user attributes: set <strong>Realm settings → General → Unmanaged attributes</strong> to <em>Admin can edit</em> or <em>Enabled</em>. Run the checks after creating the client.</p>
        </section>
      </div>
    <% } else { %>
      <div class="card">
        <header>
          <h2>Client secret</h2>
          <p>Signs results<%= client.settings.requestKey === 'secret' ? ' and checks requests' : '' %>. Keep it on the application’s server.</p>
        </header>
        <section>
          <% if (newSecret) { %>
            <div class="alert" role="status">
              <h2>Copy it now</h2>
              <section class="grid gap-2">
                <p>It won’t be shown again.</p>
                <code class="break-all rounded bg-muted px-2 py-1 text-xs"><%= newSecret %></code>
                <button type="button" class="btn justify-self-start" data-variant="outline" data-size="sm" data-copy="<%= newSecret %>">Copy</button>
              </section>
            </div>
          <% } else { %>
            <p class="text-sm text-muted-foreground">Set. Generate a new one if it was lost or exposed.</p>
          <% } %>
        </section>
        <footer class="flex justify-end">
          <form method="post" action="<%= action %>/secret" onsubmit="return confirm('Generate a new client secret? The current one stops working at once.')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn" data-variant="outline">Generate new secret</button>
          </form>
        </footer>
      </div>

      <div class="card">
        <header>
          <h2>Check setup</h2>
          <p>The sandbox service account, that the realm keeps CloakTail’s user attributes<%= client.settings.requestKey === 'jwks' ? ', and the application’s JWKS' : '' %>. Uses the saved settings.</p>
        </header>
        <section><div id="check-migration" aria-live="polite"></div></section>
        <footer class="flex justify-end">
          <button type="button" class="btn" data-variant="outline" hx-post="<%= action %>/check" hx-target="#check-migration" hx-disabled-elt="this">
            <span class="in-[.htmx-request]:hidden">Run checks</span><span class="hidden in-[.htmx-request]:inline">Checking…</span>
          </button>
        </footer>
      </div>

      <div class="card">
        <header><h2>Delete</h2><p>Requests from the application stop working. Users already created stay in Keycloak; the request history is deleted.</p></header>
        <footer class="flex justify-end">
          <button class="btn" data-variant="destructive" hx-post="<%= action %>/delete"
                  hx-confirm="Delete migration client <%= client.name %>? Its requests stop working and its history is deleted.">Delete</button>
        </footer>
      </div>

      <p class="text-xs text-muted-foreground">
        Created <%= client.createdAt %> UTC<%= client.createdBy ? ` by ${client.createdBy}` : '' %>.
        Updated <%= client.updatedAt %> UTC<%= client.updatedBy ? ` by ${client.updatedBy}` : '' %>.
      </p>
    <% } %>
  </div>
</div>

<script>
  // Show only the input of the chosen signature method.
  document.getElementById('requestKey').addEventListener('change', (e) => {
    document.querySelectorAll('[data-key-option]').forEach((el) => { el.hidden = el.dataset.keyOption !== e.target.value; });
  });
</script>
<%- include('../../partials/footer') %>
