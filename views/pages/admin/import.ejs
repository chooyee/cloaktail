<%- include('../../partials/header') %>
<%
  const conflictChoices = [
    ['rename', 'Keep both', 'Import it under a new name, like “Production (2)”.'],
    ['overwrite', 'Overwrite', 'Replace the existing profile. Secrets missing from the file are kept.'],
    ['skip', 'Skip', 'Leave the existing profile alone.'],
  ];
%>
<a href="/admin/keycloak" class="text-sm text-muted-foreground hover:underline">← Keycloak profiles</a>
<h1 class="mt-2 text-2xl font-semibold">Import Keycloak profiles</h1>
<p class="mt-1 max-w-3xl text-muted-foreground">
  Load a JSON file exported from CloakTail. Imported profiles serve no domains until you add them; overwriting a profile keeps its domains.
</p>

<form class="card mt-6 max-w-3xl" method="post" action="/admin/keycloak/import">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="grid gap-6">
    <% if (error) { %>
      <div class="alert" data-variant="destructive" role="alert">
        <h2><%= error %></h2>
        <% if (problems.length) { %>
          <section><ul class="list-disc pl-4"><% for (const p of problems) { %><li><%= p %></li><% } %></ul></section>
        <% } %>
      </div>
    <% } %>
    <% if (result) { %>
      <div class="alert" role="status">
        <h2>Import finished</h2>
        <section>
          <ul class="list-disc pl-4">
            <% if (result.created.length) { %><li>Created: <%= result.created.join(', ') %></li><% } %>
            <% if (result.overwritten.length) { %><li>Overwritten: <%= result.overwritten.join(', ') %></li><% } %>
            <% if (result.skipped.length) { %><li>Skipped (already exist): <%= result.skipped.join(', ') %></li><% } %>
          </ul>
          <p class="mt-2"><a href="/admin/keycloak" class="underline underline-offset-4">Back to the profiles</a></p>
        </section>
      </div>
    <% } %>

    <div class="field gap-1.5">
      <label for="file">JSON file</label>
      <input id="file" type="file" accept="application/json,.json" class="text-sm">
      <p class="text-xs">The file is read in your browser and placed below; nothing is sent until you import.</p>
    </div>
    <div class="field gap-1.5">
      <label for="json">Or paste the JSON</label>
      <textarea id="json" name="json" rows="10" class="font-mono text-xs" spellcheck="false" required
                placeholder='{ "format": "cloaktail-keycloak-profiles", "version": 1, "profiles": [ … ] }'><%= json %></textarea>
    </div>

    <fieldset class="grid gap-3">
      <legend class="mb-2 text-sm font-medium">When a profile with the same name exists</legend>
      <% for (const [value, label, text] of conflictChoices) { %>
        <label class="flex items-start gap-2 text-sm font-normal">
          <input type="radio" name="onConflict" value="<%= value %>" class="mt-0.5" <%= onConflict === value ? 'checked' : '' %>>
          <span><span class="font-medium"><%= label %></span><span class="block text-xs text-muted-foreground"><%= text %></span></span>
        </label>
      <% } %>
    </fieldset>
  </section>
  <footer class="flex justify-end gap-2">
    <a href="/admin/keycloak" class="btn" data-variant="outline">Cancel</a>
    <button type="submit" class="btn">Import</button>
  </footer>
</form>

<script>
  // Reads the chosen file into the textarea (the form itself posts plain text, no upload).
  document.getElementById('file').addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    if (file.size > 512 * 1024) { alert('That file is too large for a profile export.'); e.target.value = ''; return; }
    document.getElementById('json').value = await file.text();
  });
</script>
<%- include('../../partials/footer') %>
