<%- include('../../partials/header') %>
<%
  const isNew = !profile;
  const action = isNew ? '/admin/keycloak/profiles' : `/admin/keycloak/profiles/${profile.id}`;
  const fieldError = (key) => errors[key];
  // Connection checks use the form's current values (saved or not).
  const checkBase = isNew ? '/admin/keycloak/check' : `/admin/keycloak/profiles/${profile.id}/check`;
  const checkButton = (section, label) => `<button type="button" class="btn shrink-0" data-variant="outline" data-size="sm"
      hx-post="${checkBase}/${section}" hx-include="#profile-form" hx-target="#check-${section}" hx-swap="innerHTML" hx-disabled-elt="this">
      <span class="in-[.htmx-request]:hidden">${label}</span><span class="hidden in-[.htmx-request]:inline">Checking…</span></button>`;
  const checkResult = (section) => `<div id="check-${section}" aria-live="polite" class="rounded-lg border p-4 empty:hidden"></div>`;
%>
<header class="page-header">
<div class="flex min-w-0 flex-wrap items-center gap-2">
  <h1 class="page-title"><%= isNew ? 'New Keycloak profile' : profile.name %></h1>
  <% if (!isNew && profile.domains.length) { %><span class="badge" data-tone="success">Serving <%= profile.domains.length %> domain<%= profile.domains.length === 1 ? '' : 's' %></span><% } %>
</div>
</header>

<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_22rem]">
  <form id="profile-form" class="card" method="post" action="<%= action %>"
        hx-post="<%= action %>" hx-target="#profile-form" hx-select="#profile-form" hx-swap="outerHTML" hx-disinherit="*">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <section class="grid gap-8">
      <%- include('../../fragments/form-status', { error, message }) %>
      <% if (!isNew && profile.secretsUnreadable) { %>
        <div class="alert" data-variant="destructive" role="alert">
          <h2>Client secrets can’t be read</h2>
          <section>They were encrypted with a different <code>SETTINGS_KEY</code> or <code>SESSION_SECRET</code>. Enter both secrets again.</section>
        </div>
      <% } %>

      <div class="grid gap-4">
        <%- include('../../fragments/text-field', { name: 'name', label: 'Profile name', value: values.name, autocomplete: 'off',
              attrs: 'required maxlength="60"', hint: 'For example Production, Staging or Local.', invalid: fieldError('name') }) %>
        <%- include('../../fragments/text-field', { name: 'description', label: 'Description', value: values.description, autocomplete: 'off',
              attrs: 'maxlength="300"', hint: 'Optional.', invalid: fieldError('description') }) %>
      </div>

      <div class="grid gap-4">
        <div>
          <h2 class="font-semibold">Domains</h2>
          <p class="text-sm text-muted-foreground">Requests to these addresses use this profile, and see only its users, roles and sandbox data. A domain belongs to one profile.</p>
        </div>
        <% const domainsErr = fieldError('domains'); %>
        <div class="field gap-1.5" <%- domainsErr ? 'data-invalid="true"' : '' %>>
          <label for="domains">Domains</label>
          <textarea id="domains" name="domains" rows="3" class="font-mono text-xs" spellcheck="false" placeholder="<%= baseUrl %>"
                    aria-describedby="domains-hint<%= domainsErr ? ' domains-error' : '' %>" <%- domainsErr ? 'aria-invalid="true"' : '' %>><%= values.domains || '' %></textarea>
          <% if (domainsErr) { %><p id="domains-error" class="text-xs text-destructive"><%= domainsErr %></p><% } %>
          <p id="domains-hint" class="text-xs">
            One per line, with the scheme, like <code>https://portal.example.com</code>. Leave empty to keep the profile unused.
            Each domain's <code>/*</code> must be a valid redirect URI of the portal SAML client in this profile's realm.
            The admin console stays at <code><%= baseUrl %>/admin</code> whatever you enter.
          </p>
        </div>
      </div>

      <% for (const section of sections) { %>
        <div class="grid gap-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="font-semibold"><%= section.title %></h2>
              <p class="text-sm text-muted-foreground"><%= section.text %></p>
            </div>
            <%- checkButton(section.id, 'Check connection') %>
          </div>
          <%- checkResult(section.id) %>

          <% for (const f of fields.filter((x) => x.section === section.id)) {
               const err = fieldError(f.key);
               const describedBy = [f.hint && `${f.key}-hint`, err && `${f.key}-error`].filter(Boolean).join(' ');
               const isSet = Boolean(secretsSet[f.key]); %>
            <div class="field gap-1.5" <%- err ? 'data-invalid="true"' : '' %>>
              <label for="<%= f.key %>"><%= f.label %></label>
              <% if (f.multiline) { %>
                <textarea id="<%= f.key %>" name="<%= f.key %>" rows="4" class="font-mono text-xs" spellcheck="false"
                          <%- describedBy ? `aria-describedby="${describedBy}"` : '' %> <%- err ? 'aria-invalid="true"' : '' %>><%= values[f.key] || '' %></textarea>
              <% } else if (f.secret) { %>
                <input id="<%= f.key %>" name="<%= f.key %>" type="password" class="h-9 py-0" autocomplete="new-password"
                       placeholder="<%= isSet ? '•••••••• set. Leave empty to keep it.' : 'Not set' %>"
                       <%- err ? 'aria-invalid="true"' : '' %>>
              <% } else { %>
                <input id="<%= f.key %>" name="<%= f.key %>" type="text" class="h-9 py-0 font-mono text-sm" value="<%= values[f.key] || '' %>"
                       spellcheck="false" autocomplete="off" placeholder="<%= f.placeholder || '' %>" <%= f.required ? 'required' : '' %>
                       <%- describedBy ? `aria-describedby="${describedBy}"` : '' %> <%- err ? 'aria-invalid="true"' : '' %>>
              <% } %>
              <% if (err) { %><p id="<%= f.key %>-error" class="text-xs text-destructive"><%= err %></p><% } %>
              <% if (f.hint) { %><p id="<%= f.key %>-hint" class="text-xs"><%= f.hint %></p><% } %>
              <% if (f.secret && isSet) { %>
                <div class="field mt-1" data-orientation="horizontal">
                  <input type="checkbox" id="<%= f.key %>_clear" name="<%= f.key %>_clear">
                  <label for="<%= f.key %>_clear" class="text-sm font-normal">Remove the stored secret</label>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>
    <footer class="flex justify-end gap-2">
      <a href="<%= isNew ? '/admin/keycloak' : action %>" class="btn" data-variant="outline"><%= isNew ? 'Cancel' : 'Discard changes' %></a>
      <button type="submit" class="btn"><%= isNew ? 'Create profile' : 'Save profile' %></button>
    </footer>
  </form>

  <div class="grid gap-6 self-start">
    <div class="card">
      <header>
        <h2>Check all connections</h2>
        <p>The Keycloak server, both realms, the realm signing certificate, the sandbox’s OpenID Connect keys and both service accounts.
          Uses the values in the form, saved or not<%= isNew ? '' : '; empty secret fields use the stored secrets' %>. Safe to run before adding domains.</p>
      </header>
      <section>
        <div id="check-all" aria-live="polite"><p class="text-sm text-muted-foreground">Or check one connection with the button next to it.</p></div>
      </section>
      <footer class="flex justify-end">
        <%- checkButton('all', 'Check all connections') %>
      </footer>
    </div>

    <% if (isNew) { %>
      <div class="card">
        <header><h2>After you create it</h2></header>
        <section class="grid gap-2 text-sm text-muted-foreground">
          <p>The profile starts serving its domains at once. To check it first, leave the domains empty, run the connection checks, then add them.</p>
          <p>It starts with the default roles. Users, roles and sandbox data aren’t shared with other profiles.</p>
          <p>Client secrets are stored encrypted and are never shown again.</p>
        </section>
      </div>
    <% } else { %>
      <div class="card">
        <header>
          <h2><%= profile.domains.length ? 'In use' : 'Not in use' %></h2>
          <p><%= profile.domains.length ? 'Saving changes applies them to its domains at once.' : 'No domain uses this profile. Add domains to put it in use.' %></p>
        </header>
        <% if (profile.domains.length) { %>
          <section>
            <ul class="grid gap-1">
              <% for (const d of profile.domains) { %><li><a href="<%= d %>/" class="font-mono text-xs hover:underline" target="_blank" rel="noopener"><%= d %></a></li><% } %>
            </ul>
          </section>
        <% } %>
        <section class="text-xs text-muted-foreground">
          <%= data.users %> user<%= data.users === 1 ? '' : 's' %>, <%= data.apps %> application<%= data.apps === 1 ? '' : 's' %>, <%= data.test_users %> test user<%= data.test_users === 1 ? '' : 's' %>.
        </section>
      </div>

      <div class="card">
        <header>
          <h2>SAML signing certificate</h2>
          <p>This profile’s own key: CloakTail signs its SAML requests with it on this profile’s domains.</p>
        </header>
        <section class="grid gap-1 text-sm">
          <% const active = spKeys.active; %>
          <% if (!active) { %>
            <p><span class="badge" data-tone="<%= profile.domains.length ? 'danger' : 'neutral' %>">None</span>
              Keycloak sign-in is unavailable on its domains until you add one.</p>
          <% } else { %>
            <p>
              Valid until <%= active.validTo %>
              <% if (active.daysLeft < 0) { %><span class="badge ml-1" data-tone="danger">Expired</span>
              <% } else if (active.daysLeft < 30) { %><span class="badge ml-1" data-tone="warning">Expires in <%= active.daysLeft %> days</span><% } %>
            </p>
            <p class="break-all font-mono text-xs text-muted-foreground"><%= active.fingerprint %></p>
          <% } %>
          <% if (spKeys.pending) { %><p><span class="badge" data-tone="info">Pending replacement</span> waiting to be activated.</p><% } %>
        </section>
        <footer class="flex justify-end">
          <a href="/admin/keycloak/profiles/<%= profile.id %>/signing" class="btn" data-variant="outline"><%= active ? 'Manage' : 'Add a certificate' %></a>
        </footer>
      </div>

      <form class="card" method="post" action="/admin/keycloak/profiles/<%= profile.id %>/export">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <header>
          <h2>Export</h2>
          <p>Downloads this profile as JSON, to import into another CloakTail.</p>
        </header>
        <section>
          <div class="field" data-orientation="horizontal">
            <input type="checkbox" id="includeSecrets" name="includeSecrets">
            <label for="includeSecrets" class="text-sm font-normal">Include client secrets (in plain text)</label>
          </div>
        </section>
        <footer class="flex justify-end">
          <button type="submit" class="btn" data-variant="outline">Export JSON</button>
        </footer>
      </form>

      <div class="card">
        <header>
          <h2>More</h2>
        </header>
        <footer class="flex flex-wrap justify-end gap-2">
          <button class="btn" data-variant="outline" hx-post="/admin/keycloak/profiles/<%= profile.id %>/duplicate">Duplicate</button>
          <% if (profile.domains.length) { %>
            <button class="btn" data-variant="destructive" disabled title="Remove its domains first">Delete</button>
          <% } else { %>
            <button class="btn" data-variant="destructive" hx-post="/admin/keycloak/profiles/<%= profile.id %>/delete"
                    hx-confirm="Delete profile <%= profile.name %>? CloakTail also forgets its <%= data.users %> users and their roles, and its records of <%= data.apps %> applications and <%= data.test_users %> test users (Keycloak keeps them). This can't be undone; export the profile first if you may need it.">Delete</button>
          <% } %>
        </footer>
      </div>

      <p class="text-xs text-muted-foreground">
        Created <%= profile.createdAt %> UTC<%= profile.createdBy ? ` by ${profile.createdBy}` : '' %>.
        Updated <%= profile.updatedAt %> UTC<%= profile.updatedBy ? ` by ${profile.updatedBy}` : '' %>.
      </p>
    <% } %>
  </div>
</div>
<%- include('../../partials/footer') %>
