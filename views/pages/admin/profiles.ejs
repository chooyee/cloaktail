<%- include('../../partials/header') %>
<% const served = profiles.some((p) => p.domains.length); %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">Keycloak profiles</h1>
    <p class="mt-1 max-w-3xl text-muted-foreground">
      Each profile is a complete Keycloak connection and serves its own domains, with its own users, roles and sandbox data. Changes apply at once, without a restart.
    </p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/admin/keycloak/import" class="btn" data-variant="outline">Import</a>
    <a href="/admin/keycloak/new" class="btn">New profile</a>
  </div>
</div>

<div class="mt-6 grid gap-6">
  <%- include('../../fragments/form-status', { error: null, message }) %>

  <% if (!served) { %>
    <div class="alert" data-variant="destructive" role="alert">
      <h2>No profile serves a domain</h2>
      <section>The portal is unavailable on every domain until you <%= profiles.length ? 'add domains to a profile' : 'create a profile with its domains' %>, for example <code><%= baseUrl %></code>.</section>
    </div>
  <% } %>

  <% const unsigned = profiles.filter((p) => p.domains.length && !spKeys.get(p.id)?.active); %>
  <% if (unsigned.length) { %>
    <div class="alert" data-variant="destructive" role="alert">
      <h2>No SAML signing certificate</h2>
      <section>
        Keycloak sign-in is unavailable on the domains of
        <% unsigned.forEach((p, i) => { %><%= i ? ', ' : '' %><a href="/admin/keycloak/profiles/<%= p.id %>/signing" class="underline underline-offset-4"><%= p.name %></a><% }) %>.
        Each profile needs its own certificate: generate one and import it into that profile’s portal SAML client.
      </section>
    </div>
  <% } %>

  <% if (profiles.length === 0) { %>
    <div class="card">
      <section class="py-6 text-center">
        <p class="font-medium">No profiles yet</p>
        <p class="mt-1 text-sm text-muted-foreground">Create one, or import a profile exported from another CloakTail.</p>
        <div class="mt-4 flex justify-center gap-2">
          <a href="/admin/keycloak/import" class="btn" data-variant="outline">Import</a>
          <a href="/admin/keycloak/new" class="btn">New profile</a>
        </div>
      </section>
    </div>
  <% } else { %>
    <div class="card">
      <section class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr><th>Profile</th><th>Domains</th><th>Keycloak</th><th>Realms</th><th>Secrets</th><th>Signing</th><th>Updated</th><th></th></tr>
          </thead>
          <tbody>
            <% for (const p of profiles) {
                 const secretsSet = Object.values(p.secrets).filter(Boolean).length; %>
              <tr>
                <td>
                  <a href="/admin/keycloak/profiles/<%= p.id %>" class="font-medium hover:underline"><%= p.name %></a>
                  <% if (p.description) { %><p class="max-w-xs truncate text-xs text-muted-foreground"><%= p.description %></p><% } %>
                </td>
                <td class="font-mono text-xs">
                  <% for (const d of p.domains) { %><div><%= d %></div><% } %>
                  <% if (!p.domains.length) { %><span class="badge" data-variant="secondary">None</span><% } %>
                </td>
                <td class="font-mono text-xs"><%= p.settings.url %></td>
                <td class="text-xs">
                  <span class="text-muted-foreground">portal</span> <code><%= p.settings.realm %></code><br>
                  <span class="text-muted-foreground">sandbox</span> <code><%= p.settings.sandboxRealm %></code>
                </td>
                <td>
                  <% if (p.secretsUnreadable) { %><span class="badge" data-variant="destructive">Unreadable</span>
                  <% } else { %><span class="badge" data-variant="<%= secretsSet === 2 ? 'outline' : 'secondary' %>"><%= secretsSet %> of 2 set</span><% } %>
                </td>
                <td>
                  <% const keys = spKeys.get(p.id), active = keys?.active; %>
                  <a href="/admin/keycloak/profiles/<%= p.id %>/signing" class="flex flex-wrap gap-1">
                    <% if (!active) { %><span class="badge" data-variant="<%= p.domains.length ? 'destructive' : 'secondary' %>">None</span>
                    <% } else if (active.daysLeft < 0) { %><span class="badge" data-variant="destructive">Expired</span>
                    <% } else if (active.daysLeft < 30) { %><span class="badge" data-variant="destructive"><%= active.daysLeft %> days left</span>
                    <% } else { %><span class="badge" data-variant="outline">Until <%= active.validTo %></span><% } %>
                    <% if (keys?.pending) { %><span class="badge" data-variant="secondary">Pending</span><% } %>
                  </a>
                </td>
                <td class="text-xs text-muted-foreground"><%= p.updatedAt %> UTC<%= p.updatedBy ? ` by ${p.updatedBy}` : '' %></td>
                <td>
                  <div class="flex justify-end gap-1">
                    <a href="/admin/keycloak/profiles/<%= p.id %>" class="btn" data-variant="ghost" data-size="sm">Edit</a>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </section>
    </div>

    <form class="card" method="post" action="/admin/keycloak/export">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <header>
        <h2>Export all profiles</h2>
        <p>Downloads every profile as one JSON file, to back them up or move them to another CloakTail.</p>
      </header>
      <section>
        <div class="field" data-orientation="horizontal">
          <input type="checkbox" id="includeSecrets" name="includeSecrets">
          <label for="includeSecrets" class="font-normal">Include client secrets (in plain text: store the file safely)</label>
        </div>
      </section>
      <footer class="flex justify-end">
        <button type="submit" class="btn" data-variant="outline">Export <%= profiles.length %> profile<%= profiles.length === 1 ? '' : 's' %></button>
      </footer>
    </form>
  <% } %>
</div>
<%- include('../../partials/footer') %>
