<%- include('../../partials/header') %>
<header class="page-header">
<div class="min-w-0">
<h1 class="page-title">Change password</h1>
<p class="page-description">For your admin console account, <strong class="text-foreground"><%= admin.username %></strong>. Your other admin sessions are signed out.</p>
</div>
</header>

<%# A plain form, not htmx: the session (and its CSRF token) is renewed after the change. %>
<form class="card mt-8 max-w-lg" method="post" action="/admin/password">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="grid gap-4">
    <% if (admin.mustChangePassword) { %>
      <div class="alert" data-tone="warning" role="status">
        <h2>Choose your own password</h2>
        <section>You signed in with a temporary password. Set a new one to open the admin console.</section>
      </div>
    <% } %>
    <%- include('../../fragments/form-status', { error, message: changed ? 'Password changed.' : null }) %>
    <%- include('../../fragments/text-field', { name: 'currentPassword', label: admin.mustChangePassword ? 'Temporary password' : 'Current password', type: 'password', autocomplete: 'current-password', attrs: 'required' }) %>
    <%- include('../../fragments/text-field', { name: 'password', label: 'New password', type: 'password', autocomplete: 'new-password', hint: 'At least 12 characters, not containing your username.', attrs: 'required' }) %>
    <%- include('../../fragments/text-field', { name: 'confirmPassword', label: 'Confirm new password', type: 'password', autocomplete: 'new-password', attrs: 'required' }) %>
  </section>
  <footer class="flex justify-end">
    <button type="submit" class="btn">Change password</button>
  </footer>
</form>
<%- include('../../partials/footer') %>
