<%- include('../../partials/header') %>
<%# One certificate card: active or pending. Expects `k` (from getSpKeysView) and `id`. %>
<% function certCard(k, id) { %>
  <section class="grid gap-4">
    <dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[9rem_1fr]">
      <dt class="text-muted-foreground">Subject</dt><dd class="break-all"><%= k.subject %></dd>
      <dt class="text-muted-foreground">Key</dt><dd>RSA <%= k.keySize %> bit</dd>
      <dt class="text-muted-foreground">Valid</dt>
      <dd>
        <%= k.validFrom %> to <%= k.validTo %>
        <% if (k.daysLeft < 0) { %><span class="badge ml-1" data-tone="danger">Expired</span>
        <% } else if (k.daysLeft < 30) { %><span class="badge ml-1" data-tone="warning">Expires in <%= k.daysLeft %> days</span><% } %>
      </dd>
      <dt class="text-muted-foreground">SHA-256</dt><dd class="break-all font-mono text-xs"><%= k.fingerprint %></dd>
      <dt class="text-muted-foreground">Created</dt><dd><%= k.createdAt %> UTC<%= k.createdBy ? ` by ${k.createdBy}` : '' %></dd>
    </dl>
    <div class="field">
      <div class="flex items-center justify-between gap-2">
        <label for="<%= id %>">Certificate (PEM)</label>
        <div class="flex gap-1">
          <button type="button" class="btn" data-variant="ghost" data-size="xs" data-copy="<%= k.certificate %>">Copy</button>
          <button type="button" class="btn" data-variant="outline" data-size="xs" data-download="cloaktail-sp-<%= profile.id %>-<%= k.status %>-cert.pem" data-source="#<%= id %>">Download</button>
        </div>
      </div>
      <textarea id="<%= id %>" rows="6" readonly class="font-mono text-xs"><%= k.certificate %></textarea>
    </div>
  </section>
<% } %>

<header class="page-header">
<div class="min-w-0">
<h1 class="page-title">SAML signing certificate</h1>
<p class="page-description">
  On the domains of Keycloak profile <strong><%= profile.name %></strong>, CloakTail signs its SAML login and logout requests with this key.
  Keycloak checks those signatures with the certificate, so it must also be imported into the portal’s SAML client
  (<code><%= profile.settings.samlIssuer %></code> in realm <code><%= profile.settings.realm %></code>).
  Every profile has its own key. The private key is stored encrypted and never leaves the server.
</p>
</div>
<div class="page-actions"><a href="/admin/keycloak/profiles/<%= profile.id %>" class="btn" data-variant="outline">Back to <%= profile.name %></a></div>
</header>

<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_22rem]">
  <div class="grid gap-6 self-start">
    <%- include('../../fragments/form-status', { error: null, message }) %>

    <% if (pending) { %>
      <div class="card">
        <header>
          <h2>Pending replacement</h2>
          <p>Not used yet. CloakTail still signs with the active certificate below.</p>
        </header>
        <section>
          <ol class="grid list-decimal gap-1 pl-5 text-sm">
            <li>In Keycloak (<code><%= profile.settings.url %></code>), open realm <strong><%= profile.settings.realm %></strong> → <strong>Clients</strong> → <strong><%= profile.settings.samlIssuer %></strong> → <strong>Keys</strong> → <strong>Import key</strong>, archive format <strong>Certificate PEM</strong>, and upload this certificate.</li>
            <li>Then activate it here straight away. Sign-ins fail between the two steps, because Keycloak and CloakTail use different keys.</li>
          </ol>
        </section>
        <% certCard(pending, 'pending-cert') %>
        <footer class="flex flex-wrap justify-end gap-2">
          <button class="btn" data-variant="outline" hx-post="<%= signingPath %>/discard" hx-confirm="Discard the pending certificate?">Discard</button>
          <button class="btn" hx-post="<%= signingPath %>/activate"
                  hx-confirm="Activate the pending certificate? Do this only after importing it into Keycloak. The current key is deleted.">Activate</button>
        </footer>
      </div>
    <% } %>

    <div class="card">
      <header>
        <h2 class="flex items-center gap-2">Active certificate <% if (active) { %><span class="badge" data-tone="success">In use</span><% } %></h2>
        <% if (active) { %>
          <p>
            Imported into the portal SAML client? Then sign-in works.
            <% if (profile.domains.length) { %>SP metadata with this certificate:
              <a href="<%= profile.domains[0] %>/saml/metadata" class="underline underline-offset-4" target="_blank" rel="noopener"><%= profile.domains[0] %>/saml/metadata</a>.<% } %>
          </p>
        <% } %>
      </header>
      <% if (active) { %>
        <% certCard(active, 'active-cert') %>
      <% } else { %>
        <section>
          <div class="alert" data-variant="destructive" role="alert">
            <h2>No signing certificate</h2>
            <section>Keycloak sign-in on this profile’s domains is unavailable until you generate or import one. A new certificate becomes active at once.</section>
          </div>
        </section>
      <% } %>
    </div>
  </div>

  <div class="grid gap-6 self-start">
    <form class="card" method="post" action="<%= signingPath %>/generate" hx-post="<%= signingPath %>/generate" hx-target="main" hx-select="main" hx-swap="outerHTML"
          hx-disabled-elt="find button[type=submit]">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <header>
        <h2><%= active ? 'Generate a replacement' : 'Generate a certificate' %></h2>
        <p><%= active ? 'Creates a pending certificate; the active one stays in use until you activate the new one.' : 'Creates an RSA key pair and a self-signed certificate.' %></p>
      </header>
      <section class="grid gap-4">
        <%- include('../../fragments/form-status', { error, message: null }) %>
        <div class="field">
          <label for="commonName">Common name (CN)</label>
          <input id="commonName" name="commonName" type="text" required maxlength="64" value="<%= values.commonName %>">
          <p>Only a label; Keycloak doesn’t check it.</p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="field">
            <label for="keySize">Key size</label>
            <select id="keySize" name="keySize">
              <% for (const k of KEY_SIZES) { %><option value="<%= k %>" <%= values.keySize === k ? 'selected' : '' %>><%= k %> bit</option><% } %>
            </select>
          </div>
          <div class="field">
            <label for="years">Valid for</label>
            <select id="years" name="years">
              <% for (const y of VALIDITY_YEARS) { %><option value="<%= y %>" <%= values.years === y ? 'selected' : '' %>><%= y %> year<%= y > 1 ? 's' : '' %></option><% } %>
            </select>
          </div>
        </div>
      </section>
      <footer class="flex justify-end">
        <button type="submit" class="btn">
          <span class="in-[.htmx-request]:hidden">Generate</span>
          <span class="hidden in-[.htmx-request]:inline">Generating…</span>
        </button>
      </footer>
    </form>

    <details class="card" <%= importError ? 'open' : '' %>>
      <summary class="cursor-pointer px-6 font-semibold">Import an existing key pair</summary>
      <form class="mt-4 grid gap-4" method="post" action="<%= signingPath %>/import" hx-post="<%= signingPath %>/import" hx-target="main" hx-select="main" hx-swap="outerHTML">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <section class="grid gap-4">
          <p class="text-sm text-muted-foreground">For example a key from your own PKI. RSA, at least 2048 bits, PEM, private key unencrypted.</p>
          <%- include('../../fragments/form-status', { error: importError, message: null }) %>
          <div class="field" <%- importField === 'certificate' ? 'data-invalid="true"' : '' %>>
            <label for="certificate">Certificate (PEM)</label>
            <textarea id="certificate" name="certificate" rows="5" required class="font-mono text-xs" spellcheck="false" placeholder="-----BEGIN CERTIFICATE-----"></textarea>
          </div>
          <div class="field" <%- importField === 'privateKey' ? 'data-invalid="true"' : '' %>>
            <label for="privateKey">Private key (PEM)</label>
            <textarea id="privateKey" name="privateKey" rows="5" required class="font-mono text-xs" spellcheck="false" autocomplete="off" placeholder="-----BEGIN PRIVATE KEY-----"></textarea>
          </div>
        </section>
        <footer class="flex justify-end">
          <button type="submit" class="btn" data-variant="outline">Import</button>
        </footer>
      </form>
    </details>
  </div>
</div>
<%- include('../../partials/footer') %>
