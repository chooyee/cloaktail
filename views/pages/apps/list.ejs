<%- include('../../partials/header') %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold"><%= showAll ? 'All applications' : 'My applications' %></h1>
    <p class="mt-1 text-muted-foreground">
      SAML clients in the <code><%= sandboxRealm %></code> sandbox realm.
      <% if (can('apps.own')) { %><%= ownCount %> of <%= maxApps %> used.<% } %>
    </p>
  </div>
  <div class="flex gap-2">
    <% if (can('apps.view_all') && can('apps.own')) { %>
      <a href="/apps<%= showAll ? '' : '?all=1' %>" class="btn" data-variant="outline"><%= showAll ? 'Show mine' : 'Show all' %></a>
    <% } %>
    <% if (can('apps.own') && ownCount < maxApps) { %>
      <a href="/apps/new" class="btn">Register application</a>
    <% } %>
  </div>
</div>

<% if (apps.length === 0) { %>
  <div class="empty mt-8 rounded-lg border border-dashed">
    <header>
      <h3>No applications yet</h3>
      <p>Register your SAML service provider to get Keycloak connection details and a test login.</p>
    </header>
    <% if (can('apps.own')) { %>
      <section><a href="/apps/new" class="btn">Register application</a></section>
    <% } %>
  </div>
<% } else { %>
  <div class="table-container mt-6 rounded-lg border">
    <table class="table">
      <thead>
        <tr>
          <th>Application</th>
          <th>Entity ID</th>
          <% if (showAll) { %><th>Owner</th><% } %>
          <th>Last test</th>
        </tr>
      </thead>
      <tbody>
        <% for (const a of apps) { %>
          <tr>
            <td><a class="font-medium underline-offset-4 hover:underline" href="/apps/<%= a.id %>"><%= a.name %></a></td>
            <td class="max-w-xs truncate font-mono text-xs"><%= a.client_id %></td>
            <% if (showAll) { %><td><%= a.owner %></td><% } %>
            <td>
              <% if (a.last_test_ok === null) { %><span class="text-muted-foreground">Never tested</span>
              <% } else if (a.last_test_ok) { %><span class="badge" data-variant="outline">Passed</span>
              <% } else { %><span class="badge" data-variant="destructive">Failed</span><% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('../../partials/footer') %>
