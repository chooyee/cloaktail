<%- include('../partials/header') %>
<div id="api-credentials">
  <header class="page-header">
    <div class="min-w-0">
      <h1 class="page-title">API credentials</h1>
      <p class="page-description">
        Use CloakTail from scripts and AI coding agents. A credential acts as you, limited to the scopes you choose:
        it can register applications, read their secrets, set up user migration and manage test users.
      </p>
    </div>
    <div class="page-actions">
      <a href="/developers/api" class="btn" data-variant="outline"><%- icon('book') %>API reference</a>
      <a href="/developers" class="btn" data-variant="outline"><%- icon('file') %>Agent guide</a>
    </div>
  </header>

  <div class="mt-6">
    <%- include('../fragments/form-status') %>
  </div>

  <% if (created) { %>
    <section class="card mt-6" data-tone="success">
      <header>
        <h2>Credential “<%= created.name %>” created</h2>
        <p>Copy the secret now: it is shown only this once. If you lose it, revoke the credential and create another.</p>
      </header>
      <section class="grid gap-4">
        <dl class="grid gap-3">
          <%- include('../fragments/copy-row', { label: 'Client ID', value: created.clientId }) %>
          <%- include('../fragments/copy-row', { label: 'Client secret', value: created.secret }) %>
        </dl>
        <div class="grid gap-2">
          <h3 class="text-sm font-medium">Give it to your coding agent through environment variables</h3>
          <p class="text-sm text-muted-foreground">
            Save these lines, with exactly these names, in a file called <code>.env.cloaktail</code> in your project and add it to
            <code>.gitignore</code> (or put them in your shell profile with <code>export</code>). Keep them out of your app’s own
            <code>.env</code>: this credential sets things up and your app never uses it. Don’t paste the secret into a chat: chat
            transcripts are kept.
          </p>
          <% const envBlock = `CLOAKTAIL_URL=${siteUrl}\nCLOAKTAIL_CLIENT_ID=${created.clientId}\nCLOAKTAIL_CLIENT_SECRET=${created.secret}`; %>
          <div class="flex items-start gap-2">
            <pre class="min-w-0 flex-1 overflow-x-auto rounded bg-muted px-3 py-2 text-xs"><code><%= envBlock %></code></pre>
            <button type="button" class="btn" data-variant="ghost" data-size="xs" data-copy="<%= envBlock %>">Copy</button>
          </div>
        </div>
      </section>
    </section>
  <% } %>

  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="grid gap-6 self-start">
      <% if (credentials.length === 0) { %>
        <div class="empty rounded-xl border border-dashed bg-background">
          <header>
            <span class="icon-tile mx-auto mb-2"><%- icon('key') %></span>
            <h3>No API credentials yet</h3>
            <p>Create one to let a script or coding agent work with your applications.</p>
          </header>
        </div>
      <% } else { %>
        <div class="card card-table"><section>
          <table class="table">
            <thead><tr><th>Name</th><th>Client ID</th><th>Scopes</th><th>Last used</th><th>Expires</th><th class="text-right">Actions</th></tr></thead>
            <tbody>
              <% for (const c of credentials) { %>
                <% const isExpired = c.expires_at && c.expires_at <= new Date().toISOString().slice(0, 19).replace('T', ' '); %>
                <tr>
                  <td class="font-medium"><%= c.name %></td>
                  <td><code class="text-xs"><%= c.client_id %></code></td>
                  <td>
                    <div class="flex flex-wrap gap-1">
                      <% for (const s of c.scopeList) { %><span class="badge" data-tone="neutral"><%= s %></span><% } %>
                    </div>
                  </td>
                  <td class="text-sm"><%= c.last_used_at ? `${c.last_used_at} UTC` : 'Never' %></td>
                  <td class="text-sm">
                    <% if (isExpired) { %><span class="badge" data-tone="danger">Expired</span>
                    <% } else { %><%= c.expires_at ? c.expires_at.slice(0, 10) : 'Never' %><% } %>
                  </td>
                  <td class="text-right">
                    <button class="btn" data-variant="ghost" data-size="sm" hx-post="/api-credentials/<%= c.id %>/delete"
                            hx-target="#api-credentials" hx-select="#api-credentials" hx-swap="outerHTML"
                            hx-confirm="Revoke “<%= c.name %>”? Anything using it stops working at once.">Revoke</button>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </section></div>
      <% } %>

      <section class="card">
        <header>
          <h2>Using it with an AI coding agent</h2>
          <p>Claude Code, Cursor, Copilot and similar agents can set up SSO and user migration for your app.</p>
        </header>
        <section class="grid gap-3 text-sm">
          <p>With the environment variables set, tell the agent something like:</p>
          <% const prompt = `Use CloakTail (${siteUrl}) to add OpenID Connect login to this app. First read ${apiUrl}/agent.md. My API credential is in CLOAKTAIL_CLIENT_ID and CLOAKTAIL_CLIENT_SECRET.`; %>
          <div class="flex items-start gap-2">
            <pre class="min-w-0 flex-1 whitespace-pre-wrap rounded bg-muted px-3 py-2 text-xs"><%= prompt %></pre>
            <button type="button" class="btn" data-variant="ghost" data-size="xs" data-copy="<%= prompt %>">Copy</button>
          </div>
          <p class="text-muted-foreground">
            The <a class="underline" href="/developers#guide">agent guide</a> tells it the order of calls and how to handle secrets.
            The <a class="underline" href="/api/v1/openapi.json">OpenAPI document</a> has every endpoint and schema.
          </p>
        </section>
      </section>
    </div>

    <form class="card self-start" hx-post="/api-credentials" hx-target="#api-credentials" hx-select="#api-credentials" hx-swap="outerHTML">
      <header>
        <h2>New credential</h2>
        <p><%= credentials.length %> of <%= max %> used.</p>
      </header>
      <section class="grid gap-4">
        <div class="field">
          <label for="ac-name">Name</label>
          <input id="ac-name" name="name" type="text" required maxlength="60" placeholder="Claude Code on my laptop" value="<%= values.name %>">
        </div>
        <fieldset class="grid gap-2">
          <legend class="text-sm font-medium">Scopes</legend>
          <% for (const [scope, description] of Object.entries(SCOPES)) { %>
            <label class="flex items-start gap-2 text-sm">
              <input type="checkbox" class="mt-0.5" name="scopes" value="<%= scope %>" <%= values.scopes.includes(scope) ? 'checked' : '' %>>
              <span><code><%= scope %></code><br><span class="text-muted-foreground"><%= description %></span></span>
            </label>
          <% } %>
        </fieldset>
        <div class="field">
          <label for="ac-expiry">Expires after</label>
          <select id="ac-expiry" name="expiryDays">
            <% for (const [days, label] of Object.entries(EXPIRY_DAYS)) { %>
              <option value="<%= days %>" <%= values.expiryDays === days ? 'selected' : '' %>><%= label %></option>
            <% } %>
          </select>
        </div>
      </section>
      <footer class="flex justify-end">
        <button type="submit" class="btn" <%= credentials.length >= max ? 'disabled' : '' %>><%- icon('plus') %>Create credential</button>
      </footer>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
