<%- include('../partials/header') %>
<%
  const icons = {
    success: '<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.86-9.8a.75.75 0 0 0-1.22-.87l-3.24 4.53-1.6-1.6a.75.75 0 1 0-1.06 1.06l2.22 2.22a.75.75 0 0 0 1.14-.1l3.76-5.24Z" clip-rule="evenodd"/></svg>',
    info: '<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.25v2.75a.75.75 0 0 0 1.5 0V9.75A.75.75 0 0 0 10 9H9Z" clip-rule="evenodd"/></svg>',
    error: '<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/></svg>',
  };
  const notes = [
    ['Use your developer account', 'Not a sandbox test user: those only sign in during test logins.'],
    ['Forgot your password?', 'Choose “Forgot password?” on the Keycloak page if it’s offered, or ask an administrator.'],
    ['Your password stays with Keycloak', 'CloakTail never sees it. Keycloak signs you in and sends back a signed SAML assertion.'],
  ];
%>
<div class="mx-auto flex max-w-md flex-col py-6 sm:py-12">
  <div class="text-center">
    <div class="mx-auto w-fit scale-125"><%- include('../partials/logo') %></div>
    <h1 class="mt-6 text-2xl font-semibold tracking-tight">Sign in to CloakTail</h1>
    <p class="mt-2 text-sm text-muted-foreground">Welcome back. You’ll sign in on your organization’s Keycloak page, then come straight back here.</p>
  </div>

  <div class="card mt-8">
    <section class="grid gap-4">
      <% if (registered) { %>
        <div class="alert" role="status"><%- icons.success %>
          <h2>Account created</h2>
          <section>Sign in with the username and password you just chose.</section>
        </div>
      <% } %>
      <% if (loggedOut) { %>
        <div class="alert" role="status"><%- icons.info %>
          <h2>You’re signed out</h2>
          <section>You’ve been signed out of CloakTail and Keycloak.</section>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="alert" data-variant="destructive" role="alert"><%- icons.error %>
          <h2>We couldn’t sign you in</h2>
          <section>The sign-in may have taken too long, or your account may be disabled. Try again; if it keeps failing, contact an administrator.</section>
        </div>
      <% } %>

      <% if (!keycloakHost) { %>
        <div class="alert" role="status"><%- icons.info %>
          <h2>Sign-in isn’t set up yet</h2>
          <section>CloakTail isn’t connected to Keycloak yet. An administrator needs to finish the setup (a Keycloak profile and a signing certificate) in the <a href="/admin" class="underline underline-offset-4">admin console</a>.</section>
        </div>
      <% } else { %>
      <a class="btn w-full" href="/auth/login?RelayState=<%= encodeURIComponent(returnTo) %>">
        Continue with Keycloak
        <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.6l-3.9-3.7a.75.75 0 1 1 1.04-1.08l5.25 5a.75.75 0 0 1 0 1.08l-5.25 5a.75.75 0 1 1-1.04-1.08l3.9-3.72H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
      </a>
      <p class="text-center text-xs text-muted-foreground">
        You’ll be redirected to <span class="font-mono text-foreground"><%= keycloakHost %></span><% if (returnTo !== '/') { %>
        and brought back to <span class="font-mono text-foreground"><%= returnTo %></span><% } %>.
      </p>
      <% } %>
    </section>
    <footer class="block border-t pt-4">
      <ul class="grid gap-3 text-xs">
        <% for (const [title, text] of notes) { %>
          <li>
            <p class="font-medium text-foreground"><%= title %></p>
            <p class="mt-0.5 text-muted-foreground"><%= text %></p>
          </li>
        <% } %>
      </ul>
    </footer>
  </div>

  <% if (registrationEnabled) { %>
    <p class="mt-6 text-center text-sm text-muted-foreground">
      New to CloakTail? <a href="/register" class="font-medium text-foreground underline underline-offset-4">Create a developer account</a>
    </p>
  <% } %>
</div>
<%- include('../partials/footer') %>
