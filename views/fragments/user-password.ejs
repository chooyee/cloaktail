<form id="user-password" class="card" hx-post="/users/<%= kcUser.id %>/password" hx-swap="outerHTML">
  <header>
    <h2>Reset password</h2>
    <p>Sets a new Keycloak password. The realm's password policy applies.</p>
  </header>
  <section class="grid gap-4">
    <%- include('form-status') %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="field">
        <label for="password">New password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8">
      </div>
      <div class="field">
        <label for="confirmPassword">Confirm password</label>
        <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required minlength="8">
      </div>
    </div>
    <div class="field" data-orientation="horizontal">
      <input type="checkbox" id="temporary" name="temporary" checked>
      <label for="temporary">User must change password at next login</label>
    </div>
  </section>
  <footer class="flex justify-end">
    <button type="submit" class="btn" data-variant="secondary">Reset password</button>
  </footer>
</form>
