<%# Inline success/error message inside a card form. Expects optional `message` and `error`. %>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert" data-variant="destructive" role="alert"><section><%= error %></section></div>
<% } else if (typeof message !== 'undefined' && message) { %>
  <div class="alert" role="status"><section><%= message %></section></div>
<% } %>
