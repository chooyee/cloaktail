<% const footerNav = navigation({ user, admin: typeof admin !== 'undefined' ? admin : null, path: currentPath, can }); %>
<% if (footerNav.shell) { %>
      </main>
      <footer class="border-t">
        <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:px-6 lg:px-10">
          <p class="flex-1">
            <span class="badge mr-1.5 align-middle" data-tone="warning">Sandbox</span>
            For development and testing only. Don’t use real personal data or production credentials; <code><%= sandboxRealm %></code> data may be reset at any time.
          </p>
          <nav class="flex shrink-0 gap-4" aria-label="Footer">
            <a href="/guide" class="hover:text-foreground hover:underline">Guide</a>
            <a href="/troubleshooting" class="hover:text-foreground hover:underline">Troubleshooting</a>
            <a href="/disclaimer" class="hover:text-foreground hover:underline">Disclaimer</a>
          </nav>
        </div>
      </footer>
    </div>
  </div>
</body>
</html>
<% } else { %>
  </main>
<% const full = typeof fullFooter !== 'undefined' && fullFooter; %>
  <footer class="border-t <%= full ? '' : 'mt-16' %>">
    <div class="mx-auto max-w-6xl px-4 <%= full ? 'py-12' : 'py-8' %>">
      <% if (full) { %>
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
          <div>
            <a href="/" class="flex items-center gap-2 font-semibold">
              <%- include('logo') %>
              CloakTail
            </a>
            <p class="mt-3 max-w-xs text-sm text-muted-foreground">The self-service developer portal for Keycloak SAML and OpenID Connect: clients, test users and verified test logins in an isolated sandbox.</p>
          </div>
          <nav aria-label="Portal">
            <h2 class="text-sm font-semibold">Portal</h2>
            <ul class="mt-3 grid gap-2 text-sm text-muted-foreground">
              <li><a href="/apps" class="hover:text-foreground">Applications</a></li>
              <li><a href="/test-users" class="hover:text-foreground">Test users</a></li>
              <li><a href="/tools/certificate" class="hover:text-foreground">Certificate generator</a></li>
              <li><a href="<%= user ? '/' : '/login' %>" class="hover:text-foreground"><%= user ? 'Dashboard' : 'Sign in' %></a></li>
            </ul>
          </nav>
          <nav aria-label="Resources">
            <h2 class="text-sm font-semibold">Resources</h2>
            <ul class="mt-3 grid gap-2 text-sm text-muted-foreground">
              <li><a href="/#quickstart" class="hover:text-foreground">Quickstart</a></li>
              <li><a href="/#test-login" class="hover:text-foreground">How testing works</a></li>
              <li><a href="/#compare" class="hover:text-foreground">Compare testing options</a></li>
              <li><a href="/troubleshooting" class="hover:text-foreground">Troubleshooting</a></li>
              <li><a href="/tools/decode" class="hover:text-foreground">SAML decoder</a></li>
              <li><a href="/tools/decode/jwt" class="hover:text-foreground">JWT decoder</a></li>
              <li><a href="<%= sandbox.descriptorUrl %>" class="hover:text-foreground">Sandbox SAML IdP metadata</a></li>
              <li><a href="<%= sandbox.discoveryUrl %>" class="hover:text-foreground">Sandbox OIDC discovery</a></li>
            </ul>
          </nav>
          <nav aria-label="External">
            <h2 class="text-sm font-semibold">Learn more</h2>
            <ul class="mt-3 grid gap-2 text-sm text-muted-foreground">
              <li><a href="https://www.keycloak.org/documentation" class="hover:text-foreground" rel="noopener" target="_blank">Keycloak documentation ↗</a></li>
              <li><a href="https://docs.oasis-open.org/security/saml/v2.0/" class="hover:text-foreground" rel="noopener" target="_blank">SAML 2.0 specification ↗</a></li>
              <li><a href="https://openid.net/specs/openid-connect-core-1_0.html" class="hover:text-foreground" rel="noopener" target="_blank">OpenID Connect Core ↗</a></li>
              <li><a href="/disclaimer" class="hover:text-foreground">Disclaimer</a></li>
            </ul>
          </nav>
        </div>
      <% } %>
      <div class="<%= full ? 'mt-10 border-t pt-6' : '' %> grid gap-3 text-xs text-muted-foreground sm:grid-cols-[1fr_auto] sm:items-start">
        <p class="max-w-3xl">
          <strong class="text-foreground">Disclaimer:</strong>
          CloakTail and its <code><%= sandboxRealm %></code> sandbox realm are for development and testing only.
          Do not use real personal data or production credentials. Sandbox data may be reset at any time, without notice or warranty.
        </p>
        <% if (!full) { %>
          <nav class="flex gap-4 sm:justify-end" aria-label="Footer">
            <a href="/guide" class="hover:text-foreground hover:underline">Guide</a>
            <a href="/disclaimer" class="hover:text-foreground hover:underline">Full disclaimer</a>
          </nav>
        <% } %>
      </div>
    </div>
  </footer>
</body>
</html>
<% } %>
