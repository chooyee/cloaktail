<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · CloakTail</title>
<%
  const metaDescription = typeof description !== 'undefined' && description
    ? description
    : 'CloakTail is the self-service developer portal for Keycloak SAML and OpenID Connect: register clients in a sandbox realm, sign in as test users and inspect every assertion and token before you ship.';
%>
  <meta name="description" content="<%= metaDescription %>">
<% if (typeof keywords !== 'undefined' && keywords) { %>
  <meta name="keywords" content="<%= [].concat(keywords).join(', ') %>">
<% } %>
  <%# Only the public marketing pages are indexed (see app.js); everything else is private or per-user. %>
  <meta name="robots" content="<%= indexable ? 'index, follow' : 'noindex, nofollow' %>">
<% if (indexable) { %>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <%# The same content as Markdown, for LLMs and answer engines (src/content.js). %>
  <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="CloakTail guide (Markdown)">
<% } %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="CloakTail">
  <meta property="og:title" content="<%= title %> · CloakTail">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta name="twitter:card" content="summary">
<% if (typeof structuredData !== 'undefined') { %>
  <%# Escape "<" so no string in the data can close the script element. %>
  <script type="application/ld+json"><%- JSON.stringify(structuredData).replace(/</g, '\\u003c') %></script>
<% } %>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%2318181b'/%3E%3Cg fill='none' stroke='white' stroke-width='2.6' stroke-linecap='round'%3E%3Cpath d='M16.5 7.2a6.2 6.2 0 1 0 0 9.6'/%3E%3Cpath d='M16.5 16.8c1.6 1.3 3.2 1.6 4.8 1'/%3E%3C/g%3E%3C/svg%3E">
  <link rel="stylesheet" href="/static/css/app.css?v=<%= cssVersion %>">
  <%# Swap 4xx/5xx responses too: the server retargets them to #flash. %>
  <meta name="htmx-config" content='{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true}]}'>
  <script src="/static/vendor/htmx.min.js" defer></script>
  <script src="/static/vendor/basecoat.min.js" defer></script>
  <script>
    // Buttons with data-copy="text" copy it to the clipboard.
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-copy]');
      if (!btn) return;
      navigator.clipboard.writeText(btn.dataset.copy).then(() => {
        const label = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = label; }, 1200);
      });
    });
    // Buttons with data-download="file.pem" data-source="#textarea" save that text as a file.
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-download]');
      if (!btn) return;
      const text = document.querySelector(btn.dataset.source)?.value || '';
      const link = document.createElement('a');
      link.href = URL.createObjectURL(new Blob([text], { type: 'application/x-pem-file' }));
      link.download = btn.dataset.download;
      link.click();
      URL.revokeObjectURL(link.href);
    });
    // Accessible tabs: [data-tabs] wraps [role=tab] buttons whose aria-controls name their panels (arrow keys
    // move between tabs). Tabs with data-lang remember the pick, so every code sample opens in that language.
    document.addEventListener('DOMContentLoaded', () => {
      const LANG_KEY = 'cloaktail:code-lang';
      let savedLang = null;
      try { savedLang = localStorage.getItem(LANG_KEY); } catch { /* storage blocked */ }
      document.querySelectorAll('[data-tabs]').forEach((root) => {
        const tabs = [...root.querySelectorAll('[role=tab]')];
        const select = (tab) => {
          tabs.forEach((t) => {
            const on = t === tab;
            t.setAttribute('aria-selected', on);
            t.tabIndex = on ? 0 : -1;
            document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
          });
        };
        const pick = (tab) => {
          select(tab);
          if (!tab.dataset.lang) return;
          try { localStorage.setItem(LANG_KEY, tab.dataset.lang); } catch { /* storage blocked */ }
        };
        tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => pick(tab));
          tab.addEventListener('keydown', (e) => {
            const next = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
            if (!next) return;
            const target = tabs[(i + next + tabs.length) % tabs.length];
            pick(target);
            target.focus();
          });
        });
        const remembered = savedLang && tabs.find((t) => t.dataset.lang === savedLang);
        if (remembered) select(remembered);
      });
    });
  </script>
</head>
<%
  const nav = navigation({ user, admin: typeof admin !== 'undefined' ? admin : null, path: currentPath, can });
  const bleed = typeof fullBleed !== 'undefined' && fullBleed;
%>
<body class="min-h-screen bg-background text-foreground" hx-headers='{"X-CSRF-Token": "<%= csrfToken %>"}'>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:shadow">Skip to content</a>
<% if (nav.shell) { %>
  <%# ---------- Signed-in layout: tinted sidebar, content on white ---------- %>
  <% const home = nav.adminArea ? '/admin' : '/'; %>
  <div class="lg:grid lg:min-h-screen lg:grid-cols-[15rem_minmax(0,1fr)]">
    <aside class="sticky top-0 hidden h-screen flex-col border-r bg-muted/50 lg:flex">
      <div class="flex h-14 shrink-0 items-center gap-2 px-4">
        <a href="<%= home %>" class="flex items-center gap-2 font-semibold"><%- include('logo') %>CloakTail</a>
        <% if (nav.adminArea) { %><span class="badge ml-auto" data-variant="outline">Admin</span><% } %>
      </div>
      <%- include('sidebar', { nav }) %>
    </aside>

    <div class="flex min-h-screen min-w-0 flex-col">
      <header class="sticky top-0 z-20 border-b bg-background/95 backdrop-blur lg:hidden">
        <div class="relative flex h-14 items-center gap-3 px-4">
          <a href="<%= home %>" class="flex shrink-0 items-center gap-2 font-semibold"><%- include('logo') %>CloakTail</a>
          <% if (nav.adminArea) { %><span class="badge" data-variant="outline">Admin</span><% } %>
          <details class="group ml-auto">
            <summary class="btn list-none [&::-webkit-details-marker]:hidden" data-variant="outline" data-size="sm">
              <%- icon('menu') %><span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close</span>
            </summary>
            <div class="absolute inset-x-0 top-full flex max-h-[calc(100dvh-3.5rem)] flex-col overflow-y-auto border-b bg-muted shadow-lg">
              <%- include('sidebar', { nav }) %>
            </div>
          </details>
        </div>
      </header>

      <main id="main" class="flex-1 <%= bleed ? '' : 'mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 lg:px-10 lg:py-8' %>">
        <% if (!bleed && nav.group) { %>
          <%# Where am I: section / page (/ the page's own title, below the section's top level). %>
          <nav class="breadcrumb mb-3" aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center text-xs">
              <li><%= nav.group.label %></li>
              <li aria-hidden="true">/</li>
              <% if (currentPath === nav.link.href) { %>
                <li><span aria-current="page"><%= nav.link.label %></span></li>
              <% } else { %>
                <li><a href="<%= nav.link.href %>"><%= nav.link.label %></a></li>
                <li aria-hidden="true">/</li>
                <li class="min-w-0"><span aria-current="page" class="block truncate"><%= title %></span></li>
              <% } %>
            </ol>
          </nav>
        <% } %>
        <div id="flash" aria-live="polite" class="<%= bleed ? 'mx-auto max-w-6xl px-4' : '' %>"></div>
<% } else { %>
  <%# ---------- Public layout: top bar ---------- %>
  <header class="sticky top-0 z-10 border-b bg-background/90 backdrop-blur">
    <div class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-4">
      <a href="/" class="flex shrink-0 items-center gap-2 font-semibold">
        <%- include('logo') %>
        <span>CloakTail</span>
      </a>
      <nav class="hidden items-center gap-1 text-sm md:flex" aria-label="Main">
        <a href="/#quickstart" class="btn" data-variant="ghost" data-size="sm">Quickstart</a>
        <a href="/#features" class="btn" data-variant="ghost" data-size="sm">Features</a>
        <a href="/#test-login" class="btn" data-variant="ghost" data-size="sm">How testing works</a>
        <a href="/troubleshooting" class="btn" data-variant="ghost" data-size="sm" <%- currentPath.startsWith('/troubleshooting') ? 'aria-current="page"' : '' %>>Troubleshooting</a>
        <a href="/tools/decode" class="btn" data-variant="ghost" data-size="sm" <%- currentPath.startsWith('/tools/decode') ? 'aria-current="page"' : '' %>>Decoders</a>
      </nav>
      <div class="ml-auto flex items-center gap-2">
        <%# Don't offer a link to the page you're already on. %>
        <% if (currentPath !== '/login') { %><a href="/login" class="btn" data-variant="ghost" data-size="sm">Sign in</a><% } %>
        <% if (registrationEnabled && currentPath !== '/register') { %><a href="/register" class="btn" data-size="sm">Get started</a><% } %>
      </div>
    </div>
  </header>
  <main id="main" class="<%= bleed ? '' : 'mx-auto max-w-6xl px-4 py-8' %>">
    <div id="flash" aria-live="polite" class="<%= bleed ? 'mx-auto max-w-6xl px-4' : '' %>"></div>
<% } %>
