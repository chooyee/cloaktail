# --- Database (PostgreSQL; tables are created on first start) ---
dbhost=127.0.0.1
dbport=5432
database=cloaktaildb
dbuser=cloaktailadmin
dbpassword=change-me
# Optional: an account allowed to create tables (e.g. the database owner). Used only at startup when
# tables are missing; it creates them and grants dbuser access. Leave empty if dbuser may create tables.
dbadminuser=
dbadminpassword=

# --- App ---
PORT=3000
# The portal's main address. The admin console (/admin) always answers here. The domains the portal
# serves are set per Keycloak profile in the admin console; other hosts get "421 Misdirected Request".
BASE_URL=http://localhost:3000
# Set to 1 when running behind one reverse proxy (nginx, Traefik, a load balancer). The proxy must send
# X-Forwarded-Proto and X-Forwarded-Host: without them the app can't tell which domain (and so which
# Keycloak profile) a request is for. Leave empty when clients connect to the app directly.
TRUST_PROXY=
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Optional: encrypts the client secrets stored in Keycloak profiles. Defaults to SESSION_SECRET.
# Changing it (or SESSION_SECRET when this is empty) makes stored secrets unreadable: re-enter them in /admin.
SETTINGS_KEY=

# --- Admin console (/admin) ---
# Optional: creates the first administrator at startup when none exists (e.g. in Docker).
# The password (12+ characters) must be changed at first sign-in. Without these, open /admin/setup
# and enter the setup token printed in the server log.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# Comma-separated Keycloak usernames that get the "admin" app role on login
ADMIN_USERS=admin
# App role given to a user on first login when they have no roles yet
DEFAULT_ROLE=developer

# --- Developer self-registration (creates accounts in KEYCLOAK_REALM) ---
ALLOW_REGISTRATION=true
# true = Keycloak asks new users to verify their email on first sign-in (realm needs SMTP)
REGISTRATION_VERIFY_EMAIL=false

# --- Keycloak ---
# The Keycloak connection (URL, realms, client IDs and secrets) is NOT configured here. It lives in
# Keycloak profiles in the database: open /admin -> Keycloak profiles to create, switch, export
# and import them.

# The portal's SAML signing certificate is not configured here either: generate or import it in
# /admin -> Signing certificate. (An existing certs/sp-key.pem + certs/sp-cert.pem pair, or the files
# named by SAML_SP_KEY_FILE / SAML_SP_CERT_FILE, is moved into the database once on first start.)

# --- Sandbox limits ---
MAX_APPS_PER_DEVELOPER=5
MAX_TEST_USERS_PER_DEVELOPER=5
